                              <TextRuns>
                                <TextRun>
                                  <Value>5.Goods &amp; Services Tax (GST)</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>: Applicable GST shall be payable by the client as per prevailing government laws on reverse charge mechanism.</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                  </Style>
