                                  <Value>.</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>Force Majeure</Value>
